{
  "name": "founder-lab-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/prepare-pages.mjs",
    "generate": "nuxt generate && node scripts/prepare-pages.mjs",
    "preview": "npx wrangler pages dev dist",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.2.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "rolldown": "1.2.13",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
